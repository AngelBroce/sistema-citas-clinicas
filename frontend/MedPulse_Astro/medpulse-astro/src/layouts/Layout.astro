---
import '../styles/global.css';
const {title, patient=false}=Astro.props;
const links=patient ? [['/paciente','Mi panel','◈'],['/paciente/citas','Mis citas','▦'],['/paciente/reservar','Reservar cita','＋'],['/paciente/perfil','Mi perfil médico','♡'],['/paciente/asistente','Asistente virtual','✧']] : [['/','Panel principal','◈'],['/citas','Citas y calendario','▦'],['/pacientes','Historial y pacientes','♡'],['/asistente','Asistente clínico','✧'],['/medicos','Médicos','✚'],['/horarios','Horarios','◷'],['/especialidades','Especialidades','◇'],['/consultorios','Consultorios','▤'],['/usuarios','Usuarios y roles','◎']];
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} · MedPulse</title></head><body>
<aside><a class="brand" href="/">✚ <span>MedPulse<small>CLINICAL CLARITY</small></span></a><div class="workspace">{patient?'PORTAL DEL PACIENTE':'GESTIÓN CLÍNICA'}</div><nav>{links.map(([href,label,icon])=><a class:list={{active:Astro.url.pathname.replace(/\/$/,'')===href.replace(/\/$/,'')}} href={href}><span>{icon}</span>{label}</a>)}</nav><div class="aside-bottom"><a href={patient?'/':'/paciente'}>⇄ {patient?'Panel clínico':'Portal paciente'}</a><small>Demostración de interfaz</small></div></aside>
<header><button id="menu" aria-label="Abrir menú">☰</button><span>Sede Central <span class="badge">{patient?'Paciente':'Equipo clínico'}</span></span><div class="identity"><span class="avatar">{patient?'JP':'EA'}</span><span>{patient?'Juan Carlos Pérez':'Elvis · Administrador'}<small>MedPulse Clinic</small></span></div></header>
<main><div class="heading"><div><p class="eyebrow">{patient?'TU SALUD, EN UN SOLO LUGAR':'SISTEMA DE GESTIÓN DE CITAS'}</p><h1>{title}</h1></div><a class="button" href="/paciente/reservar">＋ Nueva cita</a></div><div class="demo">Vista de demostración · Datos iniciales del SQL · Los cambios se guardan solo en este navegador.</div><slot/></main><div id="toast" role="status"></div>
<script>import '../data/interactions.js';</script></body></html>