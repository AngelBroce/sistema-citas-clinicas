---
import Layout from '../layouts/Layout.astro';
import data from '../data/seeds.json';
import EntityForm from '../components/EntityForm.astro';
---
<Layout title="Consultorios" role="admin">
{data.consultorios.map((row, i) => <EntityForm table="consultorios" values={row} title={row.nombre || "Consultorio " + (i + 1)}/>)}
</Layout>