---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/seeds.json';
---

<Layout title="Directorio de Médicos y Consultorios" role="secretaria">
  <div style="margin-bottom: 22px;">
    <p class="muted" style="margin: 0;">
      Control de consultorios físicos y profesionales médicos de turno para la coordinación de citas y derivaciones.
    </p>
  </div>

  <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
    {data.medicos.map(m => {
      const espRel = data.medicos_especialidades.filter(e => e.medico_id === m.id);
      const especialidades = data.especialidades.filter(e => espRel.some(r => r.especialidad_id === e.id));
      const horarios = data.horarios_medicos.filter(h => h.medico_id === m.id);
      const room = data.consultorios.find(c => c.id === horarios[0]?.consultorio_id);

      return (
        <section class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
              <div>
                <h3 style="margin: 0 0 4px 0; color: #f8fafc; font-size: 18px;">
                  Dr(a). {m.nombres} {m.apellidos}
                </h3>
                <span style="font-size: 12px; color: #38bdf8; font-weight: 500;">
                  CMP: {m.numero_colegiatura} · Tel: {m.telefono}
                </span>
              </div>
              <span class="badge green">Activo</span>
            </div>

            <div style="margin: 14px 0; padding: 12px; background: #0c162c; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="margin-bottom: 8px;">
                <span class="muted" style="display:block; font-size: 11px;">CONSULTORIO ASIGNADO</span>
                <strong style="color: #f1f5f9; font-size: 15px;">
                  {room ? `${room.nombre} (${room.piso}) · ${room.sede}` : 'Consultorio General'}
                </strong>
              </div>
              <div style="margin-bottom: 8px;">
                <span class="muted" style="display:block; font-size: 11px;">ESPECIALIDADES</span>
                <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
                  {especialidades.map(esp => (
                    <span class="badge blue">{esp.nombre}</span>
                  ))}
                </div>
              </div>
              <div>
                <span class="muted" style="display:block; font-size: 11px;">TARIFA DE ATENCIÓN</span>
                <strong style="color: #34d399;">S/ {m.tarifa_consulta} por consulta</strong>
              </div>
            </div>

            <p style="font-size: 13px; color: #94a3b8; margin: 0 0 14px 0;">
              {m.biografia}
            </p>
          </div>

          <div style="border-top: 1px solid var(--border-subtle); padding-top: 14px; display: flex; gap: 10px;">
            <a href={`/secretaria/reservar?medicoId=${m.id}`} class="button" style="flex: 1; justify-content: center; font-size: 13px; background: #d97706;">
              ＋ Agendar con Dr. {m.apellidos.split(' ')[0]}
            </a>
          </div>
        </section>
      );
    })}
  </div>
</Layout>
