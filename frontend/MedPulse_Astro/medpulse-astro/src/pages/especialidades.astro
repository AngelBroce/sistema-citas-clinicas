---
import Layout from '../layouts/Layout.astro';
import data from '../data/seeds.json';
import EntityForm from '../components/EntityForm.astro';
---
<Layout title="Especialidades" patient={false}>
{data.especialidades.map((row,i)=><EntityForm table="especialidades" values={row} title={row.nombre || row.nombres || row.email || "Horario "+(i+1)}/>)}
</Layout>