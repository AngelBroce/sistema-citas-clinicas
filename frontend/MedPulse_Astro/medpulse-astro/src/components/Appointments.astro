---
import data from '../data/seeds.json';
const {patient=false}=Astro.props;
const citas=patient?data.citas.filter(c=>c.paciente_id===data.pacientes[0].id):data.citas;
---
<section class="card"><h2>{patient?'Mis citas':'Agenda de citas'}</h2><div class="tools"><input aria-label="Buscar cita" placeholder="Buscar paciente, médico o código…" data-search/><select aria-label="Filtrar estado" data-status><option value="">Todos los estados</option><option>CONFIRMADA</option><option>PENDIENTE</option></select><a class="button secondary" href="/paciente/reservar">Reservar cita</a></div><div class="table-wrap"><table data-table><thead><tr><th>Código / fecha</th><th>Paciente</th><th>Médico / especialidad</th><th>Consultorio</th><th>Estado</th><th>Origen</th></tr></thead><tbody>{citas.map(c=>{const m=data.medicos.find(m=>m.id===c.medico_id);const p=data.pacientes.find(p=>p.id===c.paciente_id);return <tr data-state={c.estado}><td>{c.codigo_cita}<small>{c.fecha_hora_inicio.slice(0,16).replace('T',' ')}</small></td><td>{p.nombres} {p.apellidos}<small>{c.motivo_consulta}</small></td><td>{m.nombres} {m.apellidos}<small>{data.especialidades.find(e=>e.id===c.especialidad_id).nombre}</small></td><td>{data.consultorios.find(r=>r.id===c.consultorio_id).nombre}</td><td><span class:list={['badge',c.estado==='CONFIRMADA'?'green':'amber']}>{c.estado}</span></td><td>{c.canal_origen}</td></tr>})}</tbody></table><p data-empty hidden>No hay citas que coincidan.</p></div></section>