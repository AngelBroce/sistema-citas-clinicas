---
import schema from '../data/schema.json';
const {table, values={}, title='Información', fields=schema[table]}=Astro.props;
const labels={documento_tipo:'Tipo de documento',documento_numero:'Número de documento',numero_colegiatura:'Número de colegiatura',esta_activo:'Activo',esta_activa:'Activa',duracion_cita_min:'Duración de cita (minutos)',duracion_estimada_min:'Duración estimada (minutos)'};
---
<section class="card"><h2>{title}</h2><form data-entity={table}><div class="form-grid">{fields.filter(x=>x!=='password_hash').map(name=><label>{labels[name] || name.replaceAll('_',' ').replace(/^./,x=>x.toUpperCase())}<small>{name}</small>{name.startsWith('esta_')||name==='es_principal'?<select name={name}><option value="true" selected={values[name]!==false}>Sí</option><option value="false" selected={values[name]===false}>No</option></select>:<input name={name} value={values[name]??''} readonly={name==='id'||name==='usuario_id'} type={name.includes('fecha_nacimiento')?'date':name==='email'?'email':name.startsWith('hora_')?'time':name.includes('duracion')||name==='tarifa_consulta'?'number':'text'} required={!['id','usuario_id','biografia','alergias','direccion'].includes(name)} />}</label>)}</div><div class="form-actions"><button type="submit">Guardar cambios</button><button type="button" class="button secondary" data-reset>Restablecer datos</button></div></form></section>