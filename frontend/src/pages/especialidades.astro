---
import Layout from '../layouts/Layout.astro';
import data from '../data/seeds.json';
import EntityForm from '../components/EntityForm.astro';
---
<Layout title="Especialidades" role="admin">
{data.especialidades.map((row, i) => <EntityForm table="especialidades" values={row} title={row.nombre || "Especialidad " + (i + 1)}/>)}
</Layout>