---
import Layout from '../layouts/Layout.astro';
import data from '../data/seeds.json';

const especialidades = data.especialidades;
const medicos = data.medicos;
const consultorios = data.consultorios;
---

<Layout title="Dashboard Clínico & Telemetría Ejecutiva" role="admin">
  <!-- Hero Banner del Dashboard con Selector Reactivo de Período -->
  <section class="card dash-hero animate-slide-up" style="margin-bottom: 24px;">
    <div class="dash-hero-content">
      <div class="dash-hero-badge">
        <span class="live-pulse-dot"></span>
        <span class="dash-hero-badge-title">TELEMETRÍA CLÍNICA EJECUTIVA</span>
        <span class="separator">·</span>
        <span class="dash-hero-badge-status">✓ Métricas Reactivas en Vivo</span>
      </div>
      
      <h2 class="dash-hero-title">Centro de Control y Analítica Clínica 📊</h2>
      <p class="dash-hero-desc">
        Supervisión reactiva de demanda de consultas, distribución por especialidad médica, utilización de consultorios y flujo de canales de agendamiento.
      </p>

      <div class="dash-period-filters" role="group" aria-label="Filtrar período de telemetría">
        <span class="period-label">Rango temporal:</span>
        <button type="button" class="period-btn active" data-period="all">Historial Completo</button>
        <button type="button" class="period-btn" data-period="month">Mes Actual</button>
        <button type="button" class="period-btn" data-period="week">Esta Semana</button>
        <button type="button" class="period-btn" data-period="today">Hoy</button>
      </div>
    </div>

    <div class="dash-hero-actions">
      <a class="button primary-glow" href="/reservar">
        <span>＋</span> Nueva Cita Rápida
      </a>
      <a class="button secondary-glow" href="/citas">
        <span>📅</span> Calendario Maestro
      </a>
      <button type="button" id="btn-refresh-telemetry" class="btn-refresh" title="Recalcular métricas en vivo">
        <span class="refresh-icon">🔄</span> Actualizar Datos
      </button>
    </div>
  </section>

  <!-- Fila 1: KPIs Ejecutivos con Contadores Animados -->
  <div class="dash-kpi-grid animate-slide-up delay-1" style="margin-bottom: 26px;">
    <!-- KPI 1: Citas Totales -->
    <div class="card kpi-card kpi-cyan">
      <div class="kpi-header">
        <span class="kpi-icon">📋</span>
        <span class="badge blue">Volumen Global</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">TOTAL CITAS PROCESADAS</span>
        <strong class="kpi-value" id="kpi-total-citas">0</strong>
        <div class="kpi-breakdown">
          <span id="kpi-confirmadas-tag" style="color: #34d399;">0 confirmadas</span>
          <span style="color: #64748b;">·</span>
          <span id="kpi-pendientes-tag" style="color: #fbbf24;">0 pendientes</span>
        </div>
      </div>
      <div class="kpi-progress-track">
        <div class="kpi-progress-fill" id="kpi-citas-bar" style="width: 0%; background: linear-gradient(90deg, #06b6d4, #38bdf8);"></div>
      </div>
    </div>

    <!-- KPI 2: Pacientes en Padrón -->
    <div class="card kpi-card kpi-emerald">
      <div class="kpi-header">
        <span class="kpi-icon">👥</span>
        <span class="badge green">Padrón Único</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">PACIENTES REGISTRADOS</span>
        <strong class="kpi-value" id="kpi-total-pacientes">0</strong>
        <div class="kpi-breakdown">
          <span style="color: #6ee7b7;">Cédula y Pasaporte verificado</span>
        </div>
      </div>
      <div class="kpi-progress-track">
        <div class="kpi-progress-fill" style="width: 100%; background: linear-gradient(90deg, #059669, #10b981);"></div>
      </div>
    </div>

    <!-- KPI 3: Ocupación de Consultorios -->
    <div class="card kpi-card kpi-amber">
      <div class="kpi-header">
        <span class="kpi-icon">🏥</span>
        <span class="badge amber">Capacidad Física</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">TASA DE OCUPACIÓN CLÍNICA</span>
        <strong class="kpi-value"><span id="kpi-ocupacion-pct">0</span>%</strong>
        <div class="kpi-breakdown">
          <span style="color: #fcd34d;">{consultorios.length} consultorios operativos</span>
        </div>
      </div>
      <div class="kpi-progress-track">
        <div class="kpi-progress-fill" id="kpi-ocupacion-bar" style="width: 0%; background: linear-gradient(90deg, #f59e0b, #fbbf24);"></div>
      </div>
    </div>

    <!-- KPI 4: Cero Colisiones -->
    <div class="card kpi-card kpi-purple">
      <div class="kpi-header">
        <span class="kpi-icon">🛡️</span>
        <span class="badge purple">Integridad Cero Solapes</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">EFICIENCIA ANTI DOUBLE-BOOKING</span>
        <strong class="kpi-value" style="color: #c084fc;">100%</strong>
        <div class="kpi-breakdown">
          <span style="color: #c4b5fd;">0 colisiones en agenda</span>
        </div>
      </div>
      <div class="kpi-progress-track">
        <div class="kpi-progress-fill" style="width: 100%; background: linear-gradient(90deg, #8b5cf6, #a855f7);"></div>
      </div>
    </div>
  </div>

  <!-- Fila 2: Gráficos de Barras Principales -->
  <div class="grid two animate-slide-up delay-2" style="margin-bottom: 26px;">
    <!-- Gráfico 1: Barras Verticales por Especialidad Médica -->
    <section class="card chart-panel">
      <div class="chart-header">
        <div>
          <span class="eyebrow-cyan">DISTRIBUCIÓN DE DEMANDA</span>
          <h3 class="chart-title">Citas por Especialidad Médica</h3>
        </div>
        <span class="badge blue" id="specialty-total-badge">0 citas</span>
      </div>
      <p class="chart-subtitle">
        Porcentaje y volumen de atenciones distribuidos entre las especialidades activas.
      </p>

      <!-- Gráfico de Barras Verticales Animadas -->
      <div class="v-chart-wrapper">
        <div class="v-chart-grid" id="specialties-bar-chart">
          <!-- Generado dinámicamente con barras animadas -->
        </div>
      </div>

      <div class="chart-footer-legend" id="specialties-legend">
        <!-- Leyenda dinámica -->
      </div>
    </section>

    <!-- Gráfico 2: Curva de Flujo Horario y Telemetría Pico -->
    <section class="card chart-panel">
      <div class="chart-header">
        <div>
          <span class="eyebrow-amber">DENSIDAD POR FRANJA HORARIA</span>
          <h3 class="chart-title">Flujo de Consultas por Hora</h3>
        </div>
        <div class="peak-badge" id="peak-hour-badge">
          <span>⚡ Horario Pico:</span> <strong id="peak-hour-text">—</strong>
        </div>
      </div>
      <p class="chart-subtitle">
        Carga operativa de citas distribuidas a lo largo de la jornada médica (08:00 a 18:00).
      </p>

      <!-- Gráfico de Barras de Horario -->
      <div class="v-chart-wrapper">
        <div class="v-chart-grid hourly-grid" id="hourly-bar-chart">
          <!-- Generado dinámicamente -->
        </div>
      </div>

      <div class="hourly-footer-info">
        <span>💡 Las citas se agendan automáticamente en la primera ranura libre sin colisiones.</span>
      </div>
    </section>
  </div>

  <!-- Fila 3: Ocupación de Consultorios y Canales de Reserva -->
  <div class="grid two animate-slide-up delay-3" style="margin-bottom: 26px;">
    <!-- Panel de Ocupación por Consultorio Físico -->
    <section class="card chart-panel">
      <div class="chart-header">
        <div>
          <span class="eyebrow-green">INFRAESTRUCTURA HOSPITALARIA</span>
          <h3 class="chart-title">Ocupación por Consultorio y Sala</h3>
        </div>
        <span class="badge green">Pisos 1 y 2</span>
      </div>
      <p class="chart-subtitle">
        Nivel de utilización de cada espacio clínico físico basado en turnos y citas agendadas.
      </p>

      <div class="rooms-occupancy-list" id="rooms-occupancy-list">
        <!-- Barras horizontales generadas dinámicamente -->
      </div>
    </section>

    <!-- Panel de Canales de Origen (WhatsApp Bot vs Web vs Recepción) -->
    <section class="card chart-panel">
      <div class="chart-header">
        <div>
          <span class="eyebrow-purple">CANALES DE CAPTACIÓN</span>
          <h3 class="chart-title">Origen de Reservas Clínicas</h3>
        </div>
        <span class="badge purple">Omnicanalidad</span>
      </div>
      <p class="chart-subtitle">
        Comparativa entre agendamientos automatizados vía WhatsApp, autogestión Web y ventanilla.
      </p>

      <div class="channels-list" id="channels-distribution-list">
        <!-- Generado dinámicamente -->
      </div>

      <div class="channel-callout">
        <div class="channel-callout-icon">💬</div>
        <div>
          <strong style="color: #34d399; font-size: 14px; display: block;">Asistente Virtual en WhatsApp Activo</strong>
          <span style="color: #94a3b8; font-size: 12px;">
            El triaje clínico interactivo y la reserva de citas operan 24/7 vía WhatsApp, alimentando directamente la agenda sin intermediarios.
          </span>
        </div>
      </div>
    </section>
  </div>

  <!-- Fila 4: Flujo en Vivo de Actividad Reciente -->
  <section class="card animate-slide-up delay-4" style="background: #0f172a; border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 16px; padding: 22px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 12px;">
      <div>
        <span class="eyebrow-cyan">FLUJO EN TIEMPO REAL</span>
        <h3 style="margin: 2px 0 0 0; color: #ffffff; font-size: 18px; display: flex; align-items: center; gap: 8px;">
          <span>⚡</span> Registro Reciente de Citas Clínicas
        </h3>
        <p class="muted" style="margin: 4px 0 0 0; font-size: 13px;">
          Últimas atenciones procesadas en la plataforma, combinando base de datos y nuevas reservas de pacientes.
        </p>
      </div>

      <a href="/citas" class="button secondary-glow" style="font-size: 13px; padding: 7px 16px;">
        Ver Todas en Calendario →
      </a>
    </div>

    <div class="table-wrap">
      <table data-table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr>
            <th>Cód. Cita</th>
            <th>Paciente</th>
            <th>Médico Especialista</th>
            <th>Especialidad</th>
            <th>Fecha y Hora</th>
            <th>Canal de Origen</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody id="recent-citas-tbody">
          <!-- Renderizado dinámico -->
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  /* ==========================================================================
     ESTILOS DEL DASHBOARD CLÍNICO EJECUTIVO - ANIMACIONES Y BARRAS
     ========================================================================== */

  .dash-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 28px;
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.12) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 1px solid rgba(6, 182, 212, 0.35);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }

  .dash-hero::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .dash-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 11px;
    margin-bottom: 8px;
  }

  .dash-hero-badge-title {
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.8px;
  }

  .dash-hero-badge-status {
    color: #34d399;
    font-weight: 600;
  }

  .dash-hero-title {
    font-size: 24px;
    margin: 6px 0 8px 0;
    color: #ffffff;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .dash-hero-desc {
    margin: 0 0 16px 0;
    color: #cbd5e1;
    max-width: 720px;
    font-size: 14px;
    line-height: 1.55;
  }

  .dash-period-filters {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .period-label {
    font-size: 12px;
    color: #94a3b8;
    font-weight: 600;
    margin-right: 4px;
  }

  .period-btn {
    background: #090e17;
    border: 1px solid #263342;
    color: #94a3b8;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .period-btn:hover {
    border-color: #38bdf8;
    color: #f8fafc;
    background: #131b26;
  }

  .period-btn.active {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.25) 0%, rgba(16, 185, 129, 0.25) 100%);
    border-color: #38bdf8;
    color: #38bdf8;
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.25);
  }

  .dash-hero-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 220px;
  }

  .btn-refresh {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #cbd5e1;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .btn-refresh:hover {
    background: #1e293b;
    color: #38bdf8;
    border-color: #38bdf8;
  }

  .btn-refresh.spinning .refresh-icon {
    display: inline-block;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* KPI Grid */
  .dash-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .kpi-card {
    background: #0d1522;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .kpi-card.kpi-cyan:hover { border-color: rgba(6, 182, 212, 0.5); }
  .kpi-card.kpi-emerald:hover { border-color: rgba(16, 185, 129, 0.5); }
  .kpi-card.kpi-amber:hover { border-color: rgba(245, 158, 11, 0.5); }
  .kpi-card.kpi-purple:hover { border-color: rgba(139, 92, 246, 0.5); }

  .kpi-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .kpi-icon {
    font-size: 22px;
  }

  .kpi-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #94a3b8;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .kpi-value {
    font-size: 32px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.5px;
    display: block;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  .kpi-breakdown {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    margin-top: 6px;
  }

  .kpi-progress-track {
    margin-top: 14px;
    width: 100%;
    height: 6px;
    background: #1e293b;
    border-radius: 999px;
    overflow: hidden;
  }

  .kpi-progress-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Paneles de Gráficos */
  .chart-panel {
    background: #0f172a;
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 16px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .eyebrow-cyan { font-size: 11px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; display: block; }
  .eyebrow-amber { font-size: 11px; font-weight: 800; color: #fbbf24; letter-spacing: 1px; display: block; }
  .eyebrow-green { font-size: 11px; font-weight: 800; color: #34d399; letter-spacing: 1px; display: block; }
  .eyebrow-purple { font-size: 11px; font-weight: 800; color: #c084fc; letter-spacing: 1px; display: block; }

  .chart-title {
    margin: 2px 0 0 0;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
  }

  .chart-subtitle {
    margin: 4px 0 18px 0;
    color: #94a3b8;
    font-size: 13px;
  }

  .peak-badge {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #fbbf24;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 12px;
  }

  /* Gráficos de Barras Verticales Animadas */
  .v-chart-wrapper {
    background: #090e17;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 20px 16px 12px 16px;
    margin-bottom: 14px;
    position: relative;
    overflow: hidden;
  }

  .v-chart-grid {
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    height: 190px;
    gap: 10px;
    border-bottom: 1px solid #263342;
    padding-bottom: 8px;
  }

  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    position: relative;
    cursor: pointer;
    group: bar;
  }

  .bar-val-badge {
    font-size: 11px;
    font-weight: 700;
    color: #cbd5e1;
    margin-bottom: 6px;
    font-feature-settings: "tnum";
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .bar-col:hover .bar-val-badge {
    color: #ffffff;
    transform: translateY(-2px);
  }

  .bar-track {
    width: 100%;
    max-width: 44px;
    height: 100%;
    display: flex;
    align-items: flex-end;
    background: rgba(30, 41, 59, 0.35);
    border-radius: 6px 6px 0 0;
    position: relative;
  }

  .bar-fill {
    width: 100%;
    border-radius: 6px 6px 0 0;
    height: var(--h, 0%);
    background: var(--bar-gradient, linear-gradient(180deg, #06b6d4 0%, #0284c7 100%));
    box-shadow: 0 0 10px var(--bar-glow, rgba(6, 182, 212, 0.25));
    transition: height 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s ease, filter 0.2s ease;
    animation: barRise 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--idx, 0) * 80ms);
    position: relative;
  }

  .bar-col:hover .bar-fill {
    filter: brightness(1.2);
    transform: scaleX(1.05);
    box-shadow: 0 0 16px var(--bar-glow, rgba(6, 182, 212, 0.5));
  }

  .bar-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 6px 6px 0 0;
  }

  .bar-label {
    margin-top: 8px;
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 68px;
    transition: color 0.2s ease;
  }

  .bar-col:hover .bar-label {
    color: #38bdf8;
  }

  @keyframes barRise {
    from {
      height: 0%;
      opacity: 0.3;
    }
    to {
      height: var(--h, 0%);
      opacity: 1;
    }
  }

  .chart-footer-legend {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #94a3b8;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .hourly-footer-info {
    font-size: 12px;
    color: #64748b;
    text-align: center;
  }

  /* Ocupación de Consultorios (Barras Horizontales) */
  .rooms-occupancy-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .room-meter-item {
    background: #090e17;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .room-meter-item:hover {
    border-color: rgba(56, 189, 248, 0.4);
    transform: translateX(2px);
  }

  .room-meter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .room-meter-name {
    color: #f1f5f9;
    font-size: 13px;
    font-weight: 700;
  }

  .room-meter-pct {
    font-size: 12px;
    font-weight: 800;
    color: #38bdf8;
    font-feature-settings: "tnum";
  }

  .room-meter-track {
    width: 100%;
    height: 8px;
    background: #1e293b;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .room-meter-fill {
    height: 100%;
    border-radius: 999px;
    width: var(--w, 0%);
    background: var(--room-gradient, linear-gradient(90deg, #10b981, #059669));
    transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    animation: barWidth 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes barWidth {
    from { width: 0%; }
    to { width: var(--w, 0%); }
  }

  .room-meter-sub {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #64748b;
    margin-top: 4px;
  }

  /* Canales de Distribución */
  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
  }

  .channel-row {
    background: #090e17;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 12px 14px;
  }

  .channel-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .channel-name {
    font-size: 13px;
    font-weight: 700;
    color: #f8fafc;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .channel-val {
    font-size: 12px;
    font-weight: 700;
    color: #cbd5e1;
  }

  .channel-track {
    width: 100%;
    height: 7px;
    background: #1e293b;
    border-radius: 999px;
    overflow: hidden;
  }

  .channel-fill {
    height: 100%;
    border-radius: 999px;
    width: var(--cw, 0%);
    transition: width 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .channel-callout {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .channel-callout-icon {
    font-size: 24px;
  }

  /* Responsive Design */
  @media (max-width: 1080px) {
    .dash-kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .dash-hero {
      flex-direction: column;
      align-items: flex-start;
    }
    .dash-hero-actions {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .dash-kpi-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import data from '../data/seeds.json';

  const STORAGE_KEY_CITAS = 'medpulse_citas_v2';
  const STORAGE_KEY_PATIENTS = 'medpulse_custom_patients';

  // Función animadora de números (Interpolación Suave de Conteo)
  function animateNumber(element: HTMLElement | null, endVal: number, duration = 650, suffix = '') {
    if (!element) return;
    const startVal = parseInt(element.textContent?.replace(/[^\d]/g, '') || '0', 10);
    const startTime = performance.now();

    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Easing cúbico hacia afuera
      const easeOut = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(startVal + (endVal - startVal) * easeOut);
      element.textContent = current.toLocaleString() + suffix;

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        element.textContent = endVal.toLocaleString() + suffix;
      }
    }

    requestAnimationFrame(update);
  }

  // Carga unificada de todas las citas (seeds + creadas en la app)
  function getAllCitas(): any[] {
    const list = [...data.citas];
    try {
      const custom = JSON.parse(localStorage.getItem(STORAGE_KEY_CITAS) || '[]');
      custom.forEach((cc: any) => {
        const exists = list.some(c => c.id === cc.id || c.codigo_cita === cc.codigo_cita);
        if (!exists) list.push(cc);
      });
    } catch {}
    return list;
  }

  // Carga unificada de pacientes
  function getAllPatientsCount(): number {
    let count = data.pacientes.length;
    try {
      const custom = JSON.parse(localStorage.getItem(STORAGE_KEY_PATIENTS) || '[]');
      count += custom.length;
    } catch {}
    return count;
  }

  // Paleta de gradientes para barras de especialidad
  const SPECIALTY_PALETTE: Record<number, { gradient: string; glow: string; color: string }> = {
    1: { gradient: 'linear-gradient(180deg, #10b981 0%, #059669 100%)', glow: 'rgba(16, 185, 129, 0.4)', color: '#34d399' }, // Med General
    2: { gradient: 'linear-gradient(180deg, #06b6d4 0%, #0284c7 100%)', glow: 'rgba(6, 182, 212, 0.4)', color: '#38bdf8' }, // Cardiología
    3: { gradient: 'linear-gradient(180deg, #f59e0b 0%, #d97706 100%)', glow: 'rgba(245, 158, 11, 0.4)', color: '#fbbf24' }, // Pediatría
    4: { gradient: 'linear-gradient(180deg, #8b5cf6 0%, #6d28d9 100%)', glow: 'rgba(139, 92, 246, 0.4)', color: '#a78bfa' }, // Traumatología
    5: { gradient: 'linear-gradient(180deg, #ec4899 0%, #be185d 100%)', glow: 'rgba(236, 72, 153, 0.4)', color: '#f472b6' }, // Ginecología
    6: { gradient: 'linear-gradient(180deg, #14b8a6 0%, #0f766e 100%)', glow: 'rgba(20, 184, 166, 0.4)', color: '#2dd4bf' }, // Dermatología
    7: { gradient: 'linear-gradient(180deg, #6366f1 0%, #4338ca 100%)', glow: 'rgba(99, 102, 241, 0.4)', color: '#818cf8' }, // Oftalmología
  };

  let currentPeriod = 'all';

  function filterCitasByPeriod(citas: any[], period: string): any[] {
    if (period === 'all') return citas;

    const now = new Date();
    const todayStr = now.toISOString().slice(0, 10);

    return citas.filter(c => {
      const fecha = (c.fecha_hora_inicio || c.fecha || '').slice(0, 10);
      if (!fecha) return true;

      if (period === 'today') {
        return fecha === todayStr;
      }
      if (period === 'week') {
        const cDate = new Date(fecha);
        const diffDays = Math.abs((now.getTime() - cDate.getTime()) / (1000 * 3600 * 24));
        return diffDays <= 7;
      }
      if (period === 'month') {
        return fecha.slice(0, 7) === todayStr.slice(0, 7);
      }
      return true;
    });
  }

  function renderDashboard() {
    const allCitasRaw = getAllCitas();
    const citas = filterCitasByPeriod(allCitasRaw, currentPeriod);
    const totalPatients = getAllPatientsCount();

    // 1. KPIs
    const totalCitas = citas.length;
    const confirmadas = citas.filter(c => (c.estado || '').toUpperCase() === 'CONFIRMADA').length;
    const pendientes = citas.filter(c => (c.estado || '').toUpperCase() === 'PENDIENTE').length;

    animateNumber(document.getElementById('kpi-total-citas'), totalCitas);
    animateNumber(document.getElementById('kpi-total-pacientes'), totalPatients);

    const confEl = document.getElementById('kpi-confirmadas-tag');
    const pendEl = document.getElementById('kpi-pendientes-tag');
    if (confEl) confEl.textContent = `${confirmadas} confirmadas`;
    if (pendEl) pendEl.textContent = `${pendientes} pendientes`;

    const citasBar = document.getElementById('kpi-citas-bar');
    if (citasBar) {
      const pct = totalCitas > 0 ? Math.min(Math.round((confirmadas / totalCitas) * 100), 100) : 0;
      citasBar.style.width = `${pct}%`;
    }

    // Tasa de ocupación clínica estimada
    const maxCapacity = Math.max(data.consultorios.length * 8, 1); // 8 slots diarios por consultorio
    const ocupacionPct = Math.min(Math.round((totalCitas / maxCapacity) * 100), 96);
    animateNumber(document.getElementById('kpi-ocupacion-pct'), ocupacionPct);
    const ocupBar = document.getElementById('kpi-ocupacion-bar');
    if (ocupBar) ocupBar.style.width = `${ocupacionPct}%`;

    // 2. Gráfico de Barras Verticales por Especialidad
    const specCounts: Record<number, number> = {};
    data.especialidades.forEach(e => { specCounts[e.id] = 0; });
    citas.forEach(c => {
      const sId = Number(c.especialidad_id);
      if (specCounts[sId] !== undefined) {
        specCounts[sId]++;
      } else {
        specCounts[sId] = 1;
      }
    });

    const maxSpecCount = Math.max(...Object.values(specCounts), 1);
    const specChart = document.getElementById('specialties-bar-chart');
    const specLegend = document.getElementById('specialties-legend');
    const specBadge = document.getElementById('specialty-total-badge');
    if (specBadge) specBadge.textContent = `${totalCitas} citas analizadas`;

    if (specChart) {
      specChart.innerHTML = data.especialidades.map((esp, idx) => {
        const count = specCounts[esp.id] || 0;
        const heightPct = Math.max(Math.round((count / maxSpecCount) * 88), count > 0 ? 12 : 3);
        const palette = SPECIALTY_PALETTE[esp.id] || SPECIALTY_PALETTE[1];

        // Nombre corto
        const shortName = esp.nombre.split(' ')[0];

        return `
          <div class="bar-col" title="${esp.nombre}: ${count} citas (${totalCitas > 0 ? Math.round((count / totalCitas) * 100) : 0}%)">
            <span class="bar-val-badge">${count}</span>
            <div class="bar-track">
              <div 
                class="bar-fill" 
                style="--h: ${heightPct}%; --idx: ${idx}; --bar-gradient: ${palette.gradient}; --bar-glow: ${palette.glow};"
              ></div>
            </div>
            <span class="bar-label">${shortName}</span>
          </div>
        `;
      }).join('');
    }

    if (specLegend) {
      specLegend.innerHTML = data.especialidades.slice(0, 4).map(esp => {
        const palette = SPECIALTY_PALETTE[esp.id] || SPECIALTY_PALETTE[1];
        return `
          <span class="legend-item">
            <span class="legend-dot" style="background: ${palette.color};"></span>
            ${esp.nombre}
          </span>
        `;
      }).join('');
    }

    // 3. Gráfico de Densidad por Horas (08h, 10h, 12h, 14h, 16h, 18h)
    const timeSlots = ['08:00', '10:00', '12:00', '14:00', '16:00', '18:00'];
    const timeCounts: Record<string, number> = {
      '08:00': 0, '10:00': 0, '12:00': 0, '14:00': 0, '16:00': 0, '18:00': 0
    };

    citas.forEach(c => {
      const timePart = (c.fecha_hora_inicio || '').split(' ')[1] || (c.hora || '10:00');
      const hour = parseInt(timePart.slice(0, 2), 10);
      if (hour <= 9) timeCounts['08:00']++;
      else if (hour <= 11) timeCounts['10:00']++;
      else if (hour <= 13) timeCounts['12:00']++;
      else if (hour <= 15) timeCounts['14:00']++;
      else if (hour <= 17) timeCounts['16:00']++;
      else timeCounts['18:00']++;
    });

    const maxHourCount = Math.max(...Object.values(timeCounts), 1);
    const hourlyChart = document.getElementById('hourly-bar-chart');
    let peakHour = '10:00';
    let peakVal = -1;

    Object.entries(timeCounts).forEach(([h, val]) => {
      if (val > peakVal) {
        peakVal = val;
        peakHour = h;
      }
    });

    const peakTextEl = document.getElementById('peak-hour-text');
    if (peakTextEl) peakTextEl.textContent = `${peakHour} (${peakVal} citas)`;

    if (hourlyChart) {
      hourlyChart.innerHTML = timeSlots.map((slot, idx) => {
        const count = timeCounts[slot] || 0;
        const heightPct = Math.max(Math.round((count / maxHourCount) * 88), count > 0 ? 12 : 3);
        const isPeak = slot === peakHour && count > 0;

        const gradient = isPeak
          ? 'linear-gradient(180deg, #f59e0b 0%, #d97706 100%)'
          : 'linear-gradient(180deg, #38bdf8 0%, #0369a1 100%)';
        const glow = isPeak ? 'rgba(245, 158, 11, 0.45)' : 'rgba(56, 189, 248, 0.3)';

        return `
          <div class="bar-col" title="Franja ${slot}: ${count} consultas">
            <span class="bar-val-badge" style="${isPeak ? 'color: #fbbf24; font-weight: 800;' : ''}">${count}</span>
            <div class="bar-track">
              <div 
                class="bar-fill" 
                style="--h: ${heightPct}%; --idx: ${idx}; --bar-gradient: ${gradient}; --bar-glow: ${glow};"
              ></div>
            </div>
            <span class="bar-label" style="${isPeak ? 'color: #fbbf24; font-weight: 700;' : ''}">${slot}</span>
          </div>
        `;
      }).join('');
    }

    // 4. Ocupación por Consultorios Físicos
    const roomsList = document.getElementById('rooms-occupancy-list');
    if (roomsList) {
      roomsList.innerHTML = data.consultorios.map((room, idx) => {
        const roomCitas = citas.filter(c => Number(c.consultorio_id) === room.id).length;
        const roomPct = Math.min(Math.round((roomCitas / Math.max(totalCitas / data.consultorios.length || 1, 1)) * 75) + 20, 95);

        const gradient = roomPct > 80
          ? 'linear-gradient(90deg, #f59e0b, #fbbf24)'
          : (roomPct > 50 ? 'linear-gradient(90deg, #06b6d4, #38bdf8)' : 'linear-gradient(90deg, #10b981, #34d399)');

        return `
          <div class="room-meter-item">
            <div class="room-meter-header">
              <span class="room-meter-name">🚪 ${room.nombre} · ${room.piso}</span>
              <span class="room-meter-pct">${roomPct}% Capacidad</span>
            </div>
            <div class="room-meter-track">
              <div class="room-meter-fill" style="--w: ${roomPct}%; --room-gradient: ${gradient};"></div>
            </div>
            <div class="room-meter-sub">
              <span>Sede Central · ${room.sede}</span>
              <span style="color: #cbd5e1;">${roomCitas} citas asignadas</span>
            </div>
          </div>
        `;
      }).join('');
    }

    // 5. Canales de Captación (WhatsApp Bot vs Web Paciente vs Recepción)
    const channels = {
      whatsapp: citas.filter(c => c.canal_origen === 'CHATBOT_WHATSAPP').length,
      web: citas.filter(c => c.canal_origen === 'WEB_PACIENTE').length,
      recepcion: citas.filter(c => c.canal_origen?.includes('RECEPCION') || c.canal_origen === 'ADMINISTRADOR').length
    };

    const channelsEl = document.getElementById('channels-distribution-list');
    if (channelsEl) {
      const channelConfigs = [
        { key: 'whatsapp', label: '📱 Chatbot WhatsApp (24/7)', val: channels.whatsapp, color: 'linear-gradient(90deg, #10b981, #34d399)' },
        { key: 'web', label: '🌐 Portal Web Paciente', val: channels.web, color: 'linear-gradient(90deg, #38bdf8, #0ea5e9)' },
        { key: 'recepcion', label: '🏢 Mesa de Recepción / Admisión', val: channels.recepcion, color: 'linear-gradient(90deg, #f59e0b, #fbbf24)' },
      ];

      channelsEl.innerHTML = channelConfigs.map(c => {
        const pct = totalCitas > 0 ? Math.round((c.val / totalCitas) * 100) : 0;
        return `
          <div class="channel-row">
            <div class="channel-row-header">
              <span class="channel-name">${c.label}</span>
              <span class="channel-val">${c.val} citas (${pct}%)</span>
            </div>
            <div class="channel-track">
              <div class="channel-fill" style="--cw: ${pct}%; background: ${c.color};"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    // 6. Tabla de Citas Recientes
    const recentTbody = document.getElementById('recent-citas-tbody');
    if (recentTbody) {
      const recents = [...citas].reverse().slice(0, 6);
      recentTbody.innerHTML = recents.map(c => {
        const pac = data.pacientes.find(p => p.id === c.paciente_id);
        const pacName = pac ? `${pac.nombres} ${pac.apellidos}` : 'Paciente Clínico';
        const med = data.medicos.find(m => m.id === c.medico_id);
        const medName = med ? `Dr(a). ${med.nombres} ${med.apellidos}` : 'Médico Asignado';
        const esp = data.especialidades.find(e => e.id === Number(c.especialidad_id));
        const espName = esp?.nombre || 'Consulta General';

        const isWhats = c.canal_origen === 'CHATBOT_WHATSAPP';
        const isWeb = c.canal_origen === 'WEB_PACIENTE';

        return `
          <tr>
            <td>
              <strong style="color: #38bdf8; font-family: monospace; font-size: 13px;">${c.codigo_cita || 'CIT-' + c.id?.slice(0, 6)}</strong>
            </td>
            <td>
              <strong style="color: #f1f5f9; font-size: 13px;">${pacName}</strong>
            </td>
            <td>
              <span style="color: #cbd5e1; font-size: 13px;">${medName}</span>
            </td>
            <td>
              <span class="badge blue" style="font-size: 11px;">${espName}</span>
            </td>
            <td>
              <span style="color: #94a3b8; font-size: 12px;">${(c.fecha_hora_inicio || '').slice(0, 16) || 'Programada'}</span>
            </td>
            <td>
              <span class="badge ${isWhats ? 'green' : (isWeb ? 'blue' : 'amber')}" style="font-size: 10px;">
                ${isWhats ? '📱 WhatsApp' : (isWeb ? '🌐 Web' : '🏢 Recepción')}
              </span>
            </td>
            <td>
              <span class="badge ${c.estado === 'CONFIRMADA' ? 'green' : 'amber'}" style="font-size: 11px;">
                ${c.estado || 'CONFIRMADA'}
              </span>
            </td>
          </tr>
        `;
      }).join('');
    }
  }

  function setupFilters() {
    const buttons = document.querySelectorAll('.period-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentPeriod = btn.getAttribute('data-period') || 'all';
        renderDashboard();
      });
    });

    const refreshBtn = document.getElementById('btn-refresh-telemetry');
    refreshBtn?.addEventListener('click', () => {
      refreshBtn.classList.add('spinning');
      setTimeout(() => {
        renderDashboard();
        refreshBtn.classList.remove('spinning');
      }, 400);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupFilters();
      renderDashboard();
    });
  } else {
    setupFilters();
    renderDashboard();
  }
</script>
