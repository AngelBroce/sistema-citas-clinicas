---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/seeds.json';

const doctor = data.medicos[0];
---

<Layout title="Pacientes Asignados · Expedientes Clínicos" role="doctor">
  <!-- Hero Banner de Expedientes Clínicos -->
  <section class="card patient-hero animate-slide-up" style="margin-bottom: 24px;">
    <div class="patient-hero-content">
      <div class="patient-hero-badge">
        <span class="live-pulse-dot"></span>
        <span style="font-weight: 700; color: #38bdf8; letter-spacing: 0.5px;">EXPEDIENTES CLÍNICOS</span>
        <span class="separator" style="color: #475569;">·</span>
        <span class="verified-tag" id="doc-pat-hero-name" style="color: #34d399; font-weight: 600;">Dr. {doctor.nombres} {doctor.apellidos}</span>
      </div>
      
      <h2 style="font-size: 24px; margin: 10px 0 8px 0; color: #ffffff;">Pacientes y Fichas de Atención Médica 👥</h2>
      <p style="margin: 0 0 16px 0; color: #cbd5e1; max-width: 740px; font-size: 14px; line-height: 1.6;">
        Historial clínico y antecedentes de los pacientes con citas programadas contigo en MedPulse Clinic.
      </p>

      <div class="patient-quick-tags">
        <span class="tag-chip" id="doc-patient-counter"><strong>Pacientes en Cartera:</strong> Cargando...</span>
        <span class="tag-chip" id="doc-pat-esp"><strong>Servicio:</strong> Atención Especializada</span>
        <span class="tag-chip"><strong>Cobertura:</strong> República de Panamá</span>
      </div>
    </div>

    <div class="patient-hero-actions">
      <a class="button primary-glow" href="/doctor/agenda">
        <span>📅</span> Mi agenda y citas
      </a>
      <a class="button secondary-glow" href="/doctor">
        <span>◈</span> Panel principal
      </a>
    </div>
  </section>

  <!-- Rejilla Reactiva de Expedientes de Pacientes -->
  <div id="doctor-patients-grid" class="grid" style="grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
    <p class="muted">Cargando expedientes desde Supabase...</p>
  </div>
</Layout>

<script>
  import data from '../../data/seeds.json';
  import { apiUrl, escapeHtml, getAuthHeaders, getSession } from '../../data/api';

  const session = getSession();
  const targetDoctorId = session?.usuario?.medicoId || session?.usuario?.id || data.medicos[0]?.id || '';
  const heroNameEl = document.getElementById('doc-pat-hero-name');
  if (heroNameEl && session?.usuario?.nombreCompleto) {
    heroNameEl.textContent = session.usuario.nombreCompleto;
  }

  async function renderDoctorPatients() {
    const grid = document.getElementById('doctor-patients-grid');
    const counterBadge = document.getElementById('doc-patient-counter');
    if (!grid) return;

    let docCitas: any[] = [];
    try {
      const resp = await fetch(apiUrl('/api/citas'), { headers: getAuthHeaders() });
      const json = await resp.json();
      const raw = Array.isArray(json?.data) ? json.data : [];
      docCitas = raw.filter((c: any) => c.medicoId === targetDoctorId);
    } catch {
      const stored = JSON.parse(localStorage.getItem('medpulse_citas_v2') || '[]');
      docCitas = stored.filter((c: any) => c.medico_id === targetDoctorId);
    }

    const customPatients = JSON.parse(localStorage.getItem('medpulse_custom_patients') || '[]');
    const patientMap = new Map<string, any>();

    docCitas.forEach((c: any) => {
      const pid = c.pacienteId || c.paciente_id;
      if (!pid || patientMap.has(pid)) return;
      const seedP = data.pacientes.find(p => p.id === pid);
      const custP = customPatients.find((p: any) => p.id === pid);
      const nomCompleto = c.pacienteNombre || (seedP ? `${seedP.nombres} ${seedP.apellidos}` : (custP ? `${custP.nombres} ${custP.apellidos}` : 'Paciente Registrado'));
      patientMap.set(pid, {
        id: pid,
        nombreCompleto: nomCompleto,
        documento_tipo: seedP?.documento_tipo || custP?.documento_tipo || 'CEDULA_NACIONAL',
        documento_numero: c.pacienteDocumento || seedP?.documento_numero || custP?.documento_numero || '8-0000-00000',
        telefono: c.pacienteTelefono || seedP?.telefono || custP?.telefono || '+507 6598-2118',
        email: seedP?.email || custP?.email || 'paciente@medpulse.clinic',
        grupo_sanguineo: seedP?.grupo_sanguineo || custP?.grupo_sanguineo || 'O+',
        alergias: seedP?.alergias || custP?.alergias || 'Ninguna conocida',
        lastCita: c
      });
    });

    const patientsList = Array.from(patientMap.values());
    if (counterBadge) counterBadge.innerHTML = `<strong>Pacientes en Cartera:</strong> ${patientsList.length}`;

    if (patientsList.length === 0) {
      grid.innerHTML = '<div class="card"><p class="muted" style="margin:0;">Aún no tienes pacientes con citas asignadas.</p></div>';
      return;
    }

    grid.innerHTML = patientsList.map(p => {
      const cita = p.lastCita;
      const fechaStr = String(cita?.fechaHoraInicio || cita?.fecha_hora_inicio || '').slice(0, 16).replace('T', ' ');
      const noteKey = `medpulse_note_${p.id}`;
      const savedNote = localStorage.getItem(noteKey) || '';

      return `
        <section class="card animate-slide-up" style="display: flex; flex-direction: column; justify-content: space-between; background: #0f172a; border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 14px; padding: 20px;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px; gap: 10px;">
              <div>
                <h3 style="margin: 0 0 4px 0; color: #f8fafc; font-size: 18px;">${escapeHtml(p.nombreCompleto)}</h3>
                <span style="font-size: 12px; color: #38bdf8; font-weight: 500;">
                  ${escapeHtml(p.documento_tipo)}: ${escapeHtml(p.documento_numero)} · Tel: ${escapeHtml(p.telefono)}
                </span>
                <small style="display: block; color: #94a3b8; font-size: 11px; margin-top: 2px;">Correo: ${escapeHtml(p.email)}</small>
              </div>
              <span class="badge blue">Expediente Activo</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 14px 0; padding: 12px; background: #0c162c; border-radius: 8px; border: 1px solid #1e293b;">
              <div>
                <span class="muted" style="display:block; font-size: 11px;">GRUPO SANGUÍNEO</span>
                <strong style="color: #f1f5f9; font-size: 14px;">${escapeHtml(p.grupo_sanguineo)}</strong>
              </div>
              <div>
                <span class="muted" style="display:block; font-size: 11px;">ALERGIAS</span>
                <strong style="color: #ef4444; font-size: 13px;">${escapeHtml(p.alergias)}</strong>
              </div>
              <div>
                <span class="muted" style="display:block; font-size: 11px;">TELÉFONO</span>
                <span style="color: #cbd5e1; font-size: 13px;">${escapeHtml(p.telefono)}</span>
              </div>
              <div>
                <span class="muted" style="display:block; font-size: 11px;">CÉDULA / DOC</span>
                <span style="color: #cbd5e1; font-size: 13px;">${escapeHtml(p.documento_numero)}</span>
              </div>
            </div>

            ${cita ? `
              <div style="padding: 10px 14px; border-radius: 8px; background: rgba(56, 189, 248, 0.06); border: 1px solid rgba(56, 189, 248, 0.25); margin-bottom: 14px;">
                <span style="font-size: 11px; color: #38bdf8; font-weight: 700; display: block;">ÚLTIMA CITA (${escapeHtml(cita.codigoCita || cita.codigo_cita || 'CITA')}):</span>
                <p style="margin: 3px 0 0 0; font-size: 13px; color: #e2e8f0;">
                  "${escapeHtml(cita.motivoConsulta || cita.motivo_consulta || 'Consulta de control')}"
                </p>
                <small style="color: #94a3b8; font-size: 11px; display: block; margin-top: 4px;">📅 ${escapeHtml(fechaStr)} · Estado: <strong style="color:#34d399;">${escapeHtml(cita.estado)}</strong></small>
              </div>
            ` : ''}
          </div>

          <div style="border-top: 1px solid #1e293b; padding-top: 14px; margin-top: 10px;">
            <label style="margin-bottom: 8px;">
              Notas clínicas / Evolución médica
              <textarea id="note-text-${escapeHtml(p.id)}" rows="2" placeholder="Escribe aquí las observaciones clínicas durante la consulta..." style="width: 100%; background: #090e17; border: 1px solid #263342; border-radius: 8px; padding: 8px; color: #f8fafc; font-size: 13px;">${escapeHtml(savedNote)}</textarea>
            </label>
            <button type="button" class="button primary-glow btn-save-notes" data-patient-id="${escapeHtml(p.id)}" style="width: 100%; justify-content: center; font-size: 13px;">
              💾 Guardar evolución clínica
            </button>
          </div>
        </section>
      `;
    }).join('');

    grid.querySelectorAll('.btn-save-notes').forEach(btn => {
      btn.addEventListener('click', () => {
        const pid = (btn as HTMLElement).dataset.patientId || '';
        const txt = (document.getElementById(`note-text-${pid}`) as HTMLTextAreaElement | null)?.value || '';
        localStorage.setItem(`medpulse_note_${pid}`, txt);
        const toast = document.getElementById('toast');
        if (toast) {
          toast.textContent = '✓ Evolución clínica guardada en el expediente.';
          toast.style.display = 'block';
          setTimeout(() => { if (toast) toast.style.display = 'none'; }, 3000);
        }
      });
    });
  }

  renderDoctorPatients();
</script>
