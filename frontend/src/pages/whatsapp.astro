---
import Layout from '../layouts/Layout.astro';
---

<Layout title="WhatsApp IA, Triaje y Conexión QR" role="admin">
  <!-- Bento Grid de Telemetría de WhatsApp -->
  <div class="grid" style="margin-bottom: 20px;">
    <section class="card metric" style="border-top: 3px solid #10b981;">
      <span style="display: flex; align-items: center; gap: 6px;">
        <span class="badge-dot green"></span> Línea Oficial WhatsApp
      </span>
      <strong id="wa-metric-phone" style="color: #10b981; font-size: 20px;">+507 6598-2118</strong>
      <small>Canal Exclusivo WhatsApp 24/7</small>
    </section>

    <section class="card metric" style="border-top: 3px solid #06b6d4;">
      <span>Estado de Vínculo QR</span>
      <strong id="wa-metric-status" style="color: #38bdf8; font-size: 18px;">Listo para Escanear</strong>
      <small id="wa-metric-substatus">Webhook Cloud API + Enlace Directo wa.me</small>
    </section>

    <section class="card metric" style="border-top: 3px solid #8b5cf6;">
      <span>Motor NLU / Triaje Clínico</span>
      <strong style="color: #c084fc; font-size: 18px;">Triaje + Anti-Colisión</strong>
      <small>Operación única por WhatsApp (sin chat web)</small>
    </section>

    <section class="card metric" style="border-top: 3px solid #f59e0b;">
      <span>Citas Orig. WhatsApp</span>
      <strong id="wa-metric-citas" style="color: #fbbf24; font-size: 22px;">0</strong>
      <small><a href="/citas" style="color: #38bdf8; text-decoration: underline;">Ver en Calendario Clínico →</a></small>
    </section>
  </div>

  <!-- Vista 2 Columnas: QR Oficial & Webhook Status | Reglas Guardrails & Citas por WhatsApp -->
  <div class="grid two" style="align-items: start;">
    <!-- COLUMNA IZQUIERDA: QR OFICIAL -->
    <section class="card" style="background: linear-gradient(145deg, rgba(16, 185, 129, 0.08) 0%, rgba(15, 23, 42, 0.92) 100%); border: 1px solid rgba(16, 185, 129, 0.35);">
      <div style="margin-bottom: 12px;">
        <span class="badge green" style="margin-bottom: 6px; display: inline-flex;">📱 Bot Oficial Solo WhatsApp</span>
        <h2 style="margin: 0; font-size: 18px; color: #f8fafc;">Código QR · MedPulse WhatsApp (+507 6598-2118)</h2>
      </div>

      <p style="color: #94a3b8; font-size: 13px; margin: 0 0 14px; line-height: 1.5;">
        El asistente conversacional y triaje clínico atiende <strong>exclusivamente por WhatsApp</strong>. Los pacientes escanean este QR o abren el enlace directo desde su teléfono para agendar citas reales en Supabase.
      </p>

      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 18px; background: #090d16; border: 1px solid #1e293b; border-radius: 14px;">
        <div style="background: #ffffff; padding: 12px; border-radius: 12px; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.25); display: flex; align-items: center; justify-content: center; min-width: 220px; min-height: 220px;">
          <img id="wa-qr-image" src="" alt="Código QR Oficial WhatsApp MedPulse" style="width: 200px; height: 200px; display: none; border-radius: 6px;" />
          <div id="wa-qr-placeholder" style="text-align: center; color: #0f172a; padding: 16px;">
            <strong style="font-size: 13px; display: block;">Cargando QR...</strong>
            <small style="color: #475569; font-size: 11px;">Conectando con servidor WhatsApp</small>
          </div>
        </div>

        <div style="margin-top: 12px; text-align: center;">
          <span id="qr-status-badge" class="badge green" style="font-size: 12px;">Canal WhatsApp Activo</span>
          <p id="qr-status-detail" style="margin: 6px 0 0; font-size: 12px; color: #94a3b8;">
            Línea clínica configurada: <strong style="color: #34d399;">+507 6598-2118</strong>
          </p>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; justify-content: center;">
          <button type="button" id="btn-refresh-qr" class="button" style="padding: 8px 14px; font-size: 12px;">
            🔄 Regenerar Código QR
          </button>
          <a
            id="btn-open-whatsapp-direct"
            href="https://wa.me/50765982118?text=Hola%20MedPulse,%20deseo%20agendar%20una%20cita%20m%C3%A9dica"
            target="_blank"
            rel="noopener noreferrer"
            class="button secondary"
            style="padding: 8px 14px; font-size: 12px;"
          >
            💬 Abrir en WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- COLUMNA DERECHA: REGLAS Y MONITOREO DE CITAS DESDE WHATSAPP -->
    <div style="display: flex; flex-direction: column; gap: 18px;">
      <section class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
          <h2 style="margin: 0; font-size: 16px; color: #f8fafc;">🛡️ Guardrails Clínicos del Bot</h2>
          <span class="badge blue" style="font-size: 11px;">Webhook Meta Cloud API</span>
        </div>
        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px;">
          <div style="padding: 10px; background: #0f172a; border: 1px solid #1e293b; border-radius: 10px;">
            <strong style="display: block; font-size: 12px; color: #34d399; margin-bottom: 4px;">✓ Triaje de 3 Niveles</strong>
            <span style="font-size: 12px; color: #94a3b8;">Clasifica LEVE, MODERADO y URGENTE sin emitir diagnósticos médicos.</span>
          </div>
          <div style="padding: 10px; background: #0f172a; border: 1px solid #1e293b; border-radius: 10px;">
            <strong style="display: block; font-size: 12px; color: #38bdf8; margin-bottom: 4px;">✓ Anti Double-Booking</strong>
            <span style="font-size: 12px; color: #94a3b8;">Valida disponibilidad real en Supabase antes de confirmar el turno.</span>
          </div>
          <div style="padding: 10px; background: #0f172a; border: 1px solid #1e293b; border-radius: 10px;">
            <strong style="display: block; font-size: 12px; color: #fbbf24; margin-bottom: 4px;">✓ Cero Recetas por Bot</strong>
            <span style="font-size: 12px; color: #94a3b8;">Bloquea prescripciones farmacológicas y deriva a atención presencial.</span>
          </div>
          <div style="padding: 10px; background: #0f172a; border: 1px solid #1e293b; border-radius: 10px;">
            <strong style="display: block; font-size: 12px; color: #c084fc; margin-bottom: 4px;">✓ Formato Panamá</strong>
            <span style="font-size: 12px; color: #94a3b8;">Extrae cédulas panameñas y registra pacientes con historial verificable.</span>
          </div>
        </div>
      </section>

      <section class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <div>
            <h2 style="margin: 0; font-size: 16px; color: #f8fafc;">📋 Citas Agendadas desde WhatsApp</h2>
            <p class="muted" style="margin: 4px 0 0 0;">Registro en vivo de reservas originadas por el canal WhatsApp.</p>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Código</th>
                <th>Paciente</th>
                <th>Médico / Fecha</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody id="wa-citas-tbody">
              <tr><td colspan="4" class="muted" style="text-align: center;">Cargando citas de WhatsApp...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { apiUrl, escapeHtml, getAuthHeaders } from '../data/api';

  const qrImg = document.getElementById('wa-qr-image') as HTMLImageElement | null;
  const qrPlaceholder = document.getElementById('wa-qr-placeholder');
  const statusBadge = document.getElementById('qr-status-badge');
  const statusDetail = document.getElementById('qr-status-detail');
  const metricStatus = document.getElementById('wa-metric-status');
  const metricCitas = document.getElementById('wa-metric-citas');
  const tbody = document.getElementById('wa-citas-tbody');

  async function cargarQR(regenerar = false) {
    try {
      const endpoint = regenerar ? '/api/whatsapp/qr/iniciar' : '/api/whatsapp/qr';
      const res = await fetch(apiUrl(endpoint), {
        method: regenerar ? 'POST' : 'GET',
        headers: getAuthHeaders()
      });
      if (!res.ok) throw new Error('QR error');
      const data = await res.json();
      const info = data.data || {};
      const qrSrc = info.qrDataUrl || info.qrWaMeDataUrl;

      if (qrSrc && qrImg) {
        qrImg.src = qrSrc;
        qrImg.style.display = 'block';
        if (qrPlaceholder) qrPlaceholder.style.display = 'none';
      }
      if (statusBadge) statusBadge.textContent = info.estado === 'CONECTADO' ? 'WhatsApp Conectado' : 'QR Oficial Activo';
      if (metricStatus) metricStatus.textContent = info.estado === 'CONECTADO' ? 'Conectado en Vivo' : 'Listo para Escanear';
      if (statusDetail && info.mensajeEstado) {
        statusDetail.textContent = info.mensajeEstado;
      }
    } catch {
      if (qrPlaceholder) {
        qrPlaceholder.innerHTML = '<strong style="color:#ef4444;font-size:12px;">Usa el botón "Abrir en WhatsApp"</strong>';
      }
    }
  }

  async function cargarCitasWhatsApp() {
    if (!tbody) return;
    try {
      const res = await fetch(apiUrl('/api/citas'), { headers: getAuthHeaders() });
      const data = await res.json();
      const todas = Array.isArray(data?.data) ? data.data : [];
      const citasWa = todas.filter((c: any) => (c.canalOrigen || c.canal_origen) === 'CHATBOT_WHATSAPP');

      if (metricCitas) metricCitas.textContent = String(citasWa.length);

      if (citasWa.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="muted" style="text-align: center;">No hay citas registradas desde WhatsApp todavía.</td></tr>';
        return;
      }

      tbody.innerHTML = citasWa.slice(0, 12).map((c: any) => {
        const codigo = escapeHtml(c.codigoCita || c.codigo_cita || 'CIT');
        const paciente = escapeHtml(c.pacienteNombre || 'Paciente WhatsApp');
        const doc = escapeHtml(c.pacienteDocumento || '');
        const medico = escapeHtml(c.medicoNombre || 'Médico');
        const fecha = escapeHtml(String(c.fechaHoraInicio || '').slice(0, 16).replace('T', ' '));
        const estado = String(c.estado || 'PENDIENTE');
        const badgeCls = estado === 'CONFIRMADA' || estado === 'COMPLETADA' ? 'green' : estado === 'CANCELADA' ? 'red' : 'amber';
        return `
          <tr>
            <td><strong>${codigo}</strong></td>
            <td>${paciente}<br/><small class="muted">${doc}</small></td>
            <td>${medico}<br/><small class="muted">${fecha}</small></td>
            <td><span class="badge ${badgeCls}">${escapeHtml(estado)}</span></td>
          </tr>
        `;
      }).join('');
    } catch {
      tbody.innerHTML = '<tr><td colspan="4" class="muted" style="text-align: center;">Error al consultar Supabase.</td></tr>';
    }
  }

  document.getElementById('btn-refresh-qr')?.addEventListener('click', () => cargarQR(true));
  cargarQR(false);
  cargarCitasWhatsApp();
</script>
