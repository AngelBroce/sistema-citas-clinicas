{
  "name": "medpulse-workspace",
  "version": "1.0.0",
  "description": "Sistema Inteligente de Gestión de Citas Clínicas (MedPulse)",
  "private": true,
  "scripts": {
    "dev": "node start-dev.mjs",
    "start": "node start-dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend/MedPulse_Astro/medpulse-astro run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend/MedPulse_Astro/medpulse-astro run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend/MedPulse_Astro/medpulse-astro install"
  },
  "keywords": [
    "medpulse",
    "clinical",
    "astro",
    "express",
    "postgresql",
    "triaje"
  ],
  "author": "MedPulse Team",
