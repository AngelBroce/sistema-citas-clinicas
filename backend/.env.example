# Backend MedPulse - variables de entorno (copiar a .env en local o cargar en Vercel > Settings > Environment Variables)
PORT=4000
NODE_ENV=development

# Orígenes permitidos (coma separada). *.vercel.app ya se acepta automáticamente.
CORS_ORIGIN=*

# PostgreSQL hospedado (Neon / Supabase / Vercel Postgres). Incluir ?sslmode=require en la nube.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medpulse_db

# Seguridad de sesión (cambiar en producción)
JWT_SECRET=cambiar-por-clave-secreta-larga-en-produccion
AUTH_STRICT=false

# Google Calendar (OAuth). En Vercel usar la URL *.vercel.app del backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback
